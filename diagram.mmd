graph TD
    %% Styling Definitions
    classDef ingestion fill:#e2e8f0,stroke:#64748b,stroke-width:2px,color:#0f172a,font-weight:bold,rx:8,ry:8
    classDef nonllm fill:#fef3c7,stroke:#d97706,stroke-width:2px,color:#92400e,font-weight:bold,rx:8,ry:8
    classDef llm fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0c4a6e,font-weight:bold,rx:8,ry:8
    classDef vision fill:#f3e8ff,stroke:#7e22ce,stroke-width:2px,color:#4c1d95,font-weight:bold,rx:8,ry:8
    classDef mitigation fill:#fee2e2,stroke:#dc2626,stroke-width:2px,color:#7f1d1d,font-weight:bold,rx:8,ry:8
    classDef paper fill:#ffffff,stroke:#94a3b8,stroke-width:1px,stroke-dasharray: 5 5,color:#334155,font-size:16px,font-weight:600

    %% Phase 1: Data Ingestion
    subgraph Phase1 ["Phase 1: Data Ingestion"]
        direction LR
        DOM["DOM Extractor<br/>(content.js)"]:::ingestion
        Screen["Viewport Capture<br/>(background.js)"]:::ingestion
    end

    %% Phase 2: Heuristics
    subgraph Phase2 ["Phase 2: Zero-Latency Heuristics"]
        direction LR
        Regex["Fast Regex Scan"]:::nonllm
        Struct["Structural CSS Math"]:::nonllm
        
        P1["PAPER: Mathur (2019)<br/>Defines Urgency/Scarcity Text Signatures"]:::paper
        P2["PAPER: AidUI<br/>Defines False Hierarchy Box Calculations"]:::paper
        
        P1 -.->|"Provides Rules"| Regex
        P2 -.->|"Provides Rules"| Struct
    end

    %% Connections 1 to 2
    DOM == "Extracted HTML Text" ==> Regex
    DOM == "CSS Variables (Color/Size)" ==> Struct

    %% Phase 3: DP Sentinel Orchestration
    subgraph Phase3 ["Phase 3: DP Sentinel Framework (Hybrid AI Orchestration)"]
        direction TB
        TextAPI["DeepSeek-R1 (Local API)<br/>Text Pipeline"]:::llm
        VisAPI["Qwen2.5-VL (Local API)<br/>Vision Pipeline"]:::vision
        
        P3["PAPER: Schaefer (2023)<br/>8-Category Semantic Taxonomy"]:::paper
        P4["PAPER: In-Context Learning (2023)<br/>Few-Shot Prompt Engineering"]:::paper
        P5["PAPER: 50 Shades of DP<br/>21-Category Visual Taxonomy"]:::paper
        
        P3 -.->|"Frames Semantic Logic"| TextAPI
        P4 -.->|"Prevents Hallucinations"| TextAPI
        P5 -.->|"Frames Visual Logic"| VisAPI
    end

    %% Connections 2 to 3
    Regex -- "Unmatched Ambiguous Text" --> TextAPI
    Struct -- "Unmatched Complex Layouts" --> VisAPI
    Screen == "Base64 Screenshot Image" ==> VisAPI

    %% Phase 4: Mitigation
    subgraph Phase4 ["Phase 4: Countermeasure Execution"]
        direction LR
        Mitigation["Mitigation Engine<br/>(content.js)"]:::mitigation
        P6["PAPER: Schaefer (2024)<br/>Dynamic Highlight (HLE) & Hide (HD)"]:::paper
        
        P6 -.->|"Dictates UI Injection Strategy"| Mitigation
    end

    %% Connections 3 to 4
    TextAPI == "JSON Trigger" ==> Mitigation
    VisAPI == "JSON Trigger" ==> Mitigation
